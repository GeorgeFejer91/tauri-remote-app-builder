{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/remembered-device-record-v1.json",
  "title": "Rust-owned remembered browser record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "deviceId",
    "principalId",
    "displayName",
    "origin",
    "keyAlgorithm",
    "publicKey",
    "scopes",
    "authenticationGeneration",
    "createdAtMs",
    "expiresAtMs",
    "revokedAtMs"
  ],
  "properties": {
    "deviceId": { "$ref": "#/$defs/id" },
    "principalId": { "$ref": "#/$defs/id" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "origin": { "type": "string", "format": "uri", "maxLength": 256 },
    "keyAlgorithm": { "type": "string", "minLength": 1, "maxLength": 64 },
    "publicKey": { "type": "object", "minProperties": 2, "maxProperties": 16 },
    "scopes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "authenticationGeneration": { "$ref": "#/$defs/id" },
    "createdAtMs": { "type": "integer", "minimum": 0 },
    "expiresAtMs": { "type": "integer", "minimum": 0 },
    "revokedAtMs": { "type": ["integer", "null"], "minimum": 0 }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  }
}
