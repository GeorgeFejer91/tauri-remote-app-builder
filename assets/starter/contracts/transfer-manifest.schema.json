{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/transfer-manifest-v1.json",
  "title": "Transactional upload manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "transferId", "digestAlgorithm", "files"],
  "properties": {
    "type": { "const": "example.transfer.begin.v1" },
    "transferId": { "$ref": "#/$defs/id" },
    "digestAlgorithm": { "const": "sha-256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fileId", "relativeDisplayPath", "size"],
        "properties": {
          "fileId": { "$ref": "#/$defs/id" },
          "relativeDisplayPath": { "type": "string", "minLength": 1, "maxLength": 1024 },
          "size": { "type": "integer", "minimum": 1, "maximum": 536870912 },
          "mediaType": { "type": ["string", "null"], "maxLength": 128 }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    }
  }
}
